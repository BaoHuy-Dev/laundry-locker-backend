# ============================================
# Environment Variables - Example Template
# ============================================
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values in .env
# 3. NEVER commit .env file to Git!
# ============================================

# ============================================
# Database Configuration
# ============================================
POSTGRES_DB=laundry_locker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# ============================================
# Redis Configuration
# ============================================
# Leave empty for no password, or set a password
REDIS_PASSWORD=

# ============================================
# JWT Configuration
# ============================================
# Generate a strong secret key: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_key_here_minimum_256_bits

# ============================================
# Application URLs
# ============================================
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ============================================
# Email Configuration (SMTP)
# ============================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# ============================================
# OAuth2 - Google
# ============================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ============================================
# OAuth2 - GitHub
# ============================================
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ============================================
# OAuth2 - Facebook
# ============================================
FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret

# ============================================
# OAuth2 - Zalo
# ============================================
ZALO_CLIENT_ID=your_zalo_client_id
ZALO_CLIENT_SECRET=your_zalo_client_secret

# ============================================
# VNPay Configuration (Sandbox)
# ============================================
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret

# ============================================
# MoMo Configuration (Sandbox)
# ============================================
MOMO_PARTNER_CODE=your_momo_partner_code
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key

# ============================================
# Other Settings
# ============================================
SWAGGER_ENABLED=true
RATE_LIMIT_RPM=60

